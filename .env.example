# Railway shared variables / set through dashboard, not chat
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/database
REDIS_URL=redis://host:6379/0
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Super Admins approve every video before it is published
SUPERADMIN_TELEGRAM_IDS=123456789
PUBLIC_BASE_URL=https://YOUR-SERVICE.up.railway.app
FERNET_KEY=
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_VISION_MODEL=gpt-4.1-mini
IG_APP_ID=
IG_APP_SECRET=
IG_API_VERSION=v24.0
IG_ENABLE_TRIAL=false
# MANUAL = graduate in the Instagram app; SS_PERFORMANCE = Meta auto-graduates if it performs well
IG_TRIAL_GRADUATION=MANUAL
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto
RUN_MODE=api
STORY_MAX_PARTS=10
# true = draw the AI hook text on the first Story part (off: clean video)
STORY_HOOK_OVERLAY=false
# Local Bot API server (telegram-bot-api service, private network) — videos up to 2 GB
TELEGRAM_LOCAL_MODE=true
TELEGRAM_API_BASE=http://telegram-bot-api.railway.internal:8081
BOTAPI_FILE_SERVER_URL=http://telegram-bot-api.railway.internal:8090
BOTAPI_FILE_SECRET=
